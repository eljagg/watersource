digraph ERD {
  graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.25, ranksep=0.45, splines=true, concentrate=true];
  node [shape=plaintext, fontname="Helvetica", fontsize=9];
  edge [color="#475569", arrowhead=none, arrowtail=crow, dir=both, penwidth=0.8];

  User [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0c4a6e"><font color="white"><b>accounts.User</b></font></td></tr><tr><td align="left">email, full_name, phone, user_type<br/>email_verified_at, password_changed_at<br/>groups (roles), party →</td></tr></table>>];
  Party [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0c4a6e"><font color="white"><b>ref.Party</b></font></td></tr><tr><td align="left">kind, name, address, email, phone<br/>merged_into, legacy_ids[]</td></tr></table>>];
  Parish [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#334155"><font color="white"><b>ref.Parish / Basin / WMU / SubWMU / HydrostratUnit / River</b></font></td></tr><tr><td align="left">code, name, geom (multipolygon)</td></tr></table>>];
  Well [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0369a1"><font color="white"><b>ref.Well</b> (items 1,2,7,8)</font></td></tr><tr><td align="left">name, aliases[], location(3448), easting, northing, elevation<br/>parish, basin, wmu, sub_wmu, hydrostrat_unit<br/>current_owner, driller, licence_number, use, status flags<br/>completion/pump_test/abandoned/replacement dates<br/>approval_state, classification, paper_ref, electronic_ref</td></tr></table>>];
  WellSub [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0369a1"><font color="white"><b>WellLithology · WellCasing · WellPumpTest · WellOwnershipHistory</b> (4,5,9,8)</font></td></tr><tr><td align="left">per-well child rows with paper/electronic refs</td></tr></table>>];
  Station [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0369a1"><font color="white"><b>ref.StreamflowStation</b> (11,12)</font></td></tr><tr><td align="left">name, aliases[], aquarius_identifier, river, location<br/>parish, basin, wmu, photo, location_map</td></tr></table>>];
  Spring [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0369a1"><font color="white"><b>ref.Spring</b></font></td></tr><tr><td align="left">name, location, parish</td></tr></table>>];
  WWL [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#047857"><font color="white"><b>obs.WellWaterLevel</b> (3)</font></td></tr><tr><td align="left">well, measured_at, water_level_m, well_state<br/>source, approval_state, classification</td></tr></table>>];
  SR [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#047857"><font color="white"><b>obs.StationReading</b> (13)</font></td></tr><tr><td align="left">station, read_at, recorder/observer reading, discharge</td></tr></table>>];
  WQ [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#047857"><font color="white"><b>obs.WaterQualitySample</b> (10)</font></td></tr><tr><td align="left">source_type, well/spring/station, laboratory, sampled_at, analysed_at<br/>pH, conductivity, temperature, ions… (typed columns), extra (jsonb)</td></tr></table>>];
  ABS [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#047857"><font color="white"><b>obs.AbstractionRecord</b> (6)</font></td></tr><tr><td align="left">licence, well/station, source_type, period_start/end<br/>rate, volume, daily_volume_granted, over_limit, over_limit_pct</td></tr></table>>];
  RH [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#7c2d12"><font color="white"><b>obs.RecordHistory</b> (append-only)</font></td></tr><tr><td align="left">target, old_values, new_values, reason<br/>corrected_by/at, approved_by/at, submission</td></tr></table>>];
  User -> Party; Party -> Well [label="owner/driller"]; Parish -> Well; Parish -> Station; Well -> WellSub;
  Well -> WWL; Station -> SR; Well -> WQ; Spring -> WQ; Station -> WQ; Well -> ABS; WQ -> RH [style=dashed, label="history"]; ABS -> RH [style=dashed];
}
