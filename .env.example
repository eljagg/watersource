# Copy to .env for local development. Production values live in the WRA secret store / Railway variables.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-64-random-chars
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
DATABASE_URL=postgis://ws:ws@localhost:5432/watersource
REDIS_URL=redis://localhost:6379/0
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=WaterSource Jamaica <no-reply@wra.gov.jm>
# Railway staging: DATABASE_URL=${{PostGIS.DATABASE_URL}}  REDIS_URL=${{Redis.REDIS_URL}}  (reference variables)
# Security / integrations (leave blank to disable)
CLAMAV_HOST=
DSPACE_URL=
DSPACE_USER=
DSPACE_PASSWORD=
DSPACE_COLLECTION_ID=
AQUARIUS_URL=
AQUARIUS_USER=
AQUARIUS_PASSWORD=
HGA_ODBC_DSN=
